# FarmHelper Backend Environment Variables (Example Template)
# Copy this file to .env in the server folder and fill in your values.
# NEVER commit your real .env file or real passwords to version control.

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/farmhelper?retryWrites=true&w=majority
MONGODB_URI=

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here
